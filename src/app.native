<column background="surface_subtle" grow="1">
  <if test="{showUnsupported}">
    <column grow="1" cross="center">
      <spacer grow="1"/>
      <column width="480" background="surface" border-color="border" radius="xl">
        <column padding="20" gap="8">
          <text><span mono="true">unsupported Mac</span></text>
          <text><span weight="medium">Apple Silicon required</span></text>
          <text foreground="text_muted" wrap="true">Friday runs its speech engine locally and requires an Apple Silicon Mac with macOS 14 or later.</text>
        </column>
        <separator/>
        <column padding="16" gap="8">
          <row><text foreground="text_muted">Architecture</text><spacer grow="1"/><text><span mono="true">{platformArchitecture}</span></text></row>
          <row><text foreground="text_muted">System</text><spacer grow="1"/><text><span mono="true">macOS {platformOSVersion}</span></text></row>
          <text foreground="text_muted" wrap="true">{platformMessage} Setup, model downloads, and recording are disabled.</text>
        </column>
      </column>
      <spacer grow="1"/>
    </column>
  </if>
  <else>
    <if test="{showOverlayPreview}">
      <column grow="1" cross="center" background="surface_subtle">
        <spacer grow="1"/>
        <column width="520" background="surface" border-color="border" radius="xl">
          <row padding="12" cross="center" gap="10"><text><span mono="true">friday · voice</span></text><spacer grow="1"/><text><span mono="true">● live</span></text><text foreground="text_muted">Recording capsule preview</text></row>
          <separator/>
          <row padding="16" gap="12" cross="center">
            <text><span mono="true">{waveformGlyph}</span></text>
            <column grow="1" gap="2"><text><span weight="medium">Locked</span></text><text foreground="text_muted"><span mono="true">{elapsedLabel}</span></text></column>
            <button size="sm" variant="primary" on-press="stop_recording">Stop</button>
            <button size="sm" variant="ghost" on-press="dismiss_overlay_preview">Hide</button>
            <button size="sm" variant="destructive" on-press="cancel_active">Cancel</button>
          </row>
          <separator/>
          <row padding="12"><text foreground="text_muted" wrap="true">Hide removes the capsule only. Stop transcribes. Cancel discards.</text></row>
        </column>
        <spacer grow="1"/>
      </column>
    </if>
    <else>
      <if test="{showOnboarding}">
        <column grow="1">
          <row padding="12" gap="8" cross="center">
            <text><span weight="medium">Setup</span></text>
            <spacer grow="1"/>
            <text foreground="text_muted"><span mono="true">{onboardingStepLabel}</span></text>
          </row>
          <separator/>
          <scroll grow="1">
            <column padding="12" gap="10">
              <if test="{onboardingStep == 0}">
                <column background="surface" border-color="border" radius="lg">
                  <column padding="16" gap="6">
                    <text size="heading"><span weight="medium">Your voice stays here.</span></text>
                    <text foreground="text_muted" wrap="true">Hold one shortcut, speak, and put the final words back where you started.</text>
                  </column>
                  <separator/>
                  <column padding="16" gap="12">
                    <row gap="14"><text foreground="text_muted"><span mono="true">01</span></text><column gap="2"><text><span weight="medium">Audio never leaves this Mac</span></text><text foreground="text_muted">The speech engine runs locally.</text></column></row>
                    <row gap="14"><text foreground="text_muted"><span mono="true">02</span></text><column gap="2"><text><span weight="medium">Only the final words are returned</span></text><text foreground="text_muted">No partial transcript. No history.</text></column></row>
                    <row gap="14"><text foreground="text_muted"><span mono="true">03</span></text><column gap="2"><text><span weight="medium">Every fallback is explicit</span></text><text foreground="text_muted">If exact paste is unsafe, Friday tells you it copied instead.</text></column></row>
                  </column>
                  <separator/>
                  <row padding="12"><spacer grow="1"/><button size="sm" variant="primary" on-press="onboarding_next">Set up Friday</button></row>
                </column>
              </if>

              <if test="{onboardingStep == 1}">
                <column background="surface" border-color="border" radius="lg">
                  <column padding="12" gap="6">
                    <text><span weight="medium" scale="1.4">Three permissions. Three jobs.</span></text>
                    <text foreground="text_muted" wrap="true">Friday reports what macOS allows, not what it requested.</text>
                  </column>
                  <separator/>
                  <column padding="12" gap="10">
                    <row gap="12" cross="center"><if test="{microphonePermission}"><text><span mono="true">●</span></text></if><else><text foreground="text_muted"><span mono="true">○</span></text></else><column grow="1" gap="2"><text><span weight="medium">Microphone</span></text><text foreground="text_muted">{permissionMicrophoneState}</text></column><if test="{not microphonePermission}"><button size="sm" on-press="request_microphone">Allow Microphone</button></if></row>
                    <row gap="12" cross="center"><if test="{accessibilityPermission}"><text><span mono="true">●</span></text></if><else><text foreground="text_muted"><span mono="true">○</span></text></else><column grow="1" gap="2"><text><span weight="medium">Accessibility</span></text><text foreground="text_muted">Return final text to the exact source app.</text></column><if test="{not accessibilityPermission}"><button size="sm" on-press="request_accessibility">Open Accessibility</button></if></row>
                    <row gap="12" cross="center"><if test="{inputMonitoringPermission}"><text><span mono="true">●</span></text></if><else><text foreground="text_muted"><span mono="true">○</span></text></else><column grow="1" gap="2"><text><span weight="medium">Input Monitoring</span></text><text foreground="text_muted" wrap="true">Hear the shortcut while another app is focused.</text></column><if test="{not inputMonitoringPermission}"><button size="sm" on-press="request_input_monitoring">Open Input Monitoring</button></if></row>
                    <if test="{not inputMonitoringPermission or not accessibilityPermission}"><column padding="12" gap="8" background="surface_subtle" border-color="border" radius="md"><text><span weight="medium">Limited mode</span></text><text foreground="text_muted" wrap="true">Manual Start works without Input Monitoring. Without Accessibility, final text is copied. Status refreshes automatically.</text><row><spacer grow="1"/><button size="sm" variant="ghost" on-press="accept_limited_mode">Use limited mode</button></row></column></if>
                  </column>
                  <separator/>
                  <row padding="12" gap="8"><button size="sm" variant="ghost" on-press="onboarding_back">Back</button><spacer grow="1"/><button size="sm" variant="primary" on-press="onboarding_next" disabled="{not microphonePermission or ((not inputMonitoringPermission or not accessibilityPermission) and not limitedModeAccepted)}">Continue</button></row>
                </column>
              </if>

              <if test="{onboardingStep == 2}">
                <column background="surface" border-color="border" radius="lg">
                  <column padding="16" gap="6">
                    <text><span weight="medium" scale="1.4">One gesture between thought and text.</span></text>
                    <text foreground="text_muted" wrap="true">Choose a preset, or press and release Fn/Globe by itself. Ordinary typing and known system shortcuts are rejected.</text>
                  </column>
                  <separator/>
                  <column padding="16" gap="12">
                    <row><if test="{hotkeyConfirmed}"><text><span mono="true">● active</span></text></if><else><text foreground="text_muted"><span mono="true">shortcut / unset</span></text></else><spacer grow="1"/><text foreground="text_muted">global control</text></row>
                    <text><span mono="true">{hotkeyLabel}</span></text>
                    <toggle-group gap="8" label="Shortcut presets"><toggle-button size="sm" selected="{hotkeyChoice == 'command_shift'}" on-toggle="choose_command_shift">Command + Shift</toggle-button><toggle-button size="sm" selected="{hotkeyChoice == 'control_option'}" on-toggle="choose_control_option">Control + Option</toggle-button></toggle-group>
                    <button size="sm" variant="outline" on-press="start_hotkey_capture" disabled="{hotkeyCaptureActive}">Record another shortcut…</button>
                    <if test="{hotkeyCaptureActive}"><column padding="12" gap="6" background="surface_subtle" border-color="border" radius="md"><text><span weight="medium">Press your shortcut now</span></text><text foreground="text_muted" wrap="true">For Fn/Globe alone, press once and release. An F-key or any modified key also works.</text><button size="sm" variant="ghost" on-press="cancel_hotkey_capture">Cancel</button></column></if>
                    <if test="{hasHotkeyCandidate}"><column padding="12" gap="8" background="surface_subtle" border-color="border" radius="md"><text foreground="text_muted">You pressed</text><text><span mono="true">{hotkeyCandidateDisplay}</span></text><if test="{hasHotkeyWarning}"><text wrap="true">{hotkeyCandidateWarning}</text></if><row gap="8"><button size="sm" variant="primary" on-press="confirm_hotkey_candidate" disabled="{not hotkeyCandidateValid}">Use This Shortcut</button><button size="sm" variant="ghost" on-press="cancel_hotkey_capture">Try Something Else</button></row></column></if>
                    <if test="{hotkeyConfirmed}"><row gap="8" cross="center"><text><span mono="true">●</span></text><text grow="1">{hotkeyLabel} is active.</text></row></if>
                  </column>
                  <separator/>
                  <row padding="12" gap="8"><button size="sm" variant="ghost" on-press="onboarding_back">Back</button><spacer grow="1"/><button size="sm" variant="primary" on-press="onboarding_next" disabled="{not hotkeyConfirmed and not limitedModeAccepted}">Continue</button></row>
                </column>
              </if>

              <if test="{onboardingStep == 3}">
                <column background="surface" border-color="border" radius="lg">
                  <column padding="16" gap="6">
                    <text><span weight="medium" scale="1.4">Run the model here.</span></text>
                    <text foreground="text_muted" wrap="true">Parakeet turns speech into final text on this Mac. The verified download is about 714 MB.</text>
                  </column>
                  <separator/>
                  <column padding="16" gap="12">
                    <row><text><span mono="true">nvidia / parakeet</span></text><spacer grow="1"/><text foreground="text_muted"><span mono="true">{modelDownloadState}</span></text></row>
                    <row gap="12" cross="center"><if test="{modelReady}"><text><span mono="true">●</span></text></if><else><text foreground="text_muted"><span mono="true">○</span></text></else><column grow="1" gap="2"><text><span weight="medium">Parakeet TDT 0.6B v3</span></text><text foreground="text_muted">25 languages · CC-BY-4.0 · 714 MB</text></column></row>
                    <if test="{modelDownloadState == 'idle'}"><row gap="8"><button size="sm" variant="primary" on-press="retry_model_download">Download Parakeet</button><button size="sm" on-press="choose_local_model">Choose Local Model…</button></row></if>
                    <if test="{modelDownloadActive}"><column gap="8"><progress value="{modelDownloadedBytes / modelTotalBytes}" label="Parakeet download progress"/><text foreground="text_muted"><span mono="true">{modelDownloadedBytesLabel} / {modelTotalBytesLabel} bytes</span></text><button size="sm" variant="outline" on-press="cancel_model_download">Cancel Download</button></column></if>
                    <if test="{modelDownloadPaused}"><column gap="8"><text>A verified partial is ready.</text><progress value="{modelDownloadedBytes / modelTotalBytes}" label="Paused Parakeet download progress"/><text foreground="text_muted"><span mono="true">{modelDownloadedBytesLabel} / {modelTotalBytesLabel} bytes downloaded</span></text><row gap="8"><button size="sm" variant="primary" on-press="retry_model_download">Resume Download</button><button size="sm" on-press="choose_local_model">Choose Local Model…</button><button size="sm" variant="ghost" on-press="cleanup_model_downloads">Remove Partial Download</button></row></column></if>
                    <if test="{modelDownloadFailed}"><column gap="8"><text>The download stopped before verification.</text><row gap="8"><button size="sm" variant="primary" on-press="retry_model_download">Retry Download</button><button size="sm" on-press="choose_local_model">Choose Local Model…</button><button size="sm" variant="ghost" on-press="cleanup_model_downloads" disabled="{modelDownloadActive}">Remove Partial Download</button></row></column></if>
                    <if test="{modelReady}"><text>Ready for local transcription</text></if>
                    <text foreground="text_muted" wrap="true">{modelDownloadMessage}</text>
                  </column>
                  <separator/>
                  <row padding="12" gap="8"><button size="sm" variant="ghost" on-press="onboarding_back" disabled="{modelDownloadActive}">Back</button><spacer grow="1"/><button size="sm" variant="primary" on-press="complete_onboarding" disabled="{not canCompleteOnboarding}">Finish Setup</button></row>
                </column>
              </if>
            </column>
          </scroll>
        </column>
      </if>
      <else>
        <row grow="1" background="surface">
          <column width="148" padding="12" gap="6" background="surface_subtle">
            <column padding="8" gap="4"><text><span weight="bold" scale="1.6">Friday</span></text><text size="sm" foreground="text_muted">VOICE / LOCAL</text></column>
            <spacer height="18"/>
            <tree label="Friday sections" gap="6">
              <list-item role="treeitem" size="sm" icon="settings" selected="{showSettings}" on-press="show_settings">Controls</list-item>
              <list-item role="treeitem" size="sm" icon="folder" selected="{showModels}" on-press="show_models">Models</list-item>
              <list-item role="treeitem" size="sm" icon="eye" selected="{showPermissions}" on-press="show_permissions">Access</list-item>
              <list-item role="treeitem" size="sm" icon="terminal" selected="{showDiagnostics}" on-press="show_diagnostics">Diagnostics</list-item>
            </tree>
            <spacer grow="1"/>
            <column padding="8" gap="4"><text size="sm" foreground="text_muted">ON DEVICE</text><text size="sm" foreground="text_muted">Private by design.</text></column>
          </column>
          <column width="1" background="border"/>
          <scroll grow="1">
            <column padding="20" gap="10">
              <column gap="8">
                <row gap="12" cross="center">
                  <if test="{isReady}"><icon name="check-circle" width="20" height="20" foreground="accent"/></if>
                  <else><if test="{isRecording}"><icon name="mic" width="20" height="20" foreground="destructive"/></if><else><if test="{isBusy}"><icon name="clock" width="20" height="20" foreground="accent"/></if><else><icon name="alert" width="20" height="20" foreground="warning"/></else></else></else>
                  <column grow="1"><if test="{isReady}"><text><span weight="medium" scale="1.4">Ready when you are.</span></text></if><else><text><span weight="medium" scale="1.4">{workflowName}</span></text></else></column>
                  <row gap="8" cross="center">
                    <if test="{isRecording}"><text><span mono="true">{elapsedLabel}</span></text></if>
                    <row gap="8">
                      <if test="{isReady}"><button size="sm" icon="play" variant="primary" on-press="start_recording">Start Recording</button></if>
                      <if test="{isRecording}"><button size="sm" variant="primary" on-press="stop_recording">Stop Recording</button></if>
                      <if test="{isBusy}"><button size="sm" variant="ghost" on-press="cancel_active">Cancel</button></if>
                      <if test="{not isReady and not isBusy and not isFailed}"><if test="{not microphonePermission}"><button size="sm" variant="primary" on-press="request_microphone">Allow Microphone</button></if><else><if test="{not modelReady}"><button size="sm" variant="primary" on-press="show_models">Set Up Model</button></if><else><button size="sm" variant="primary" on-press="show_permissions">Review Access</button></else></else></if>
                    </row>
                  </row>
                </row>
                <text size="sm" foreground="text_muted" wrap="true">{workflowDetail}</text>
                <if test="{isRecording}"><progress value="{elapsedMilliseconds / 600000}" label="Recording duration"/></if>
              </column>
              <separator/>
              <if test="{isFailed}"><column padding="16" gap="8" background="surface" border-color="border" radius="lg"><text><span mono="true">attention required</span></text><text><span weight="medium">Model: {failureModelName}</span></text><text wrap="true">{failureDetail}</text><row gap="8"><if test="{canRetry}"><button size="sm" variant="primary" on-press="retry_transcription">Retry Transcription</button></if><if test="{hasImmediateResult and immediateResultKind == 'shown'}"><button size="sm" on-press="copy_immediate_result">Copy Final Text</button></if><button size="sm" on-press="copy_diagnostics_fresh">Copy Diagnostics</button><button size="sm" on-press="show_models">Change Model</button><button size="sm" variant="ghost" on-press="dismiss_failure">Dismiss</button></row></column></if>
              <if test="{showSettings}">
                <column gap="10">
                  <row gap="12" cross="center"><column grow="1" gap="2"><text><span weight="medium">{microphoneDisplayName}</span></text><text size="sm" foreground="text_muted" wrap="true">{microphoneDetail}</text></column><button size="sm" variant="ghost" on-press="refresh_microphone">Check Microphone</button></row>
                  <separator/>
                  <row gap="12" cross="center"><column grow="1" gap="2"><text><span weight="medium">{hotkeyLabel}</span></text><if test="{inputMonitoringPermission}"><text size="sm" foreground="text_muted">Hold to talk · release to finish</text></if><else><text size="sm">Shortcut access needed</text></else></column><if test="{inputMonitoringPermission}"><button size="sm" variant="outline" on-press="start_hotkey_capture" disabled="{hotkeyCaptureActive}">Change Shortcut…</button></if><else><button size="sm" variant="outline" on-press="request_input_monitoring">Enable Shortcut…</button></else></row>
                  <separator/>
                  <column gap="8">
                    <row cross="center"><text grow="1">Double-tap to lock recording</text><switch size="sm" checked="{doubleTapEnabled}" disabled="{isBusy}" on-toggle="toggle_double_tap" label="Double-tap to lock recording"/></row>
                    <row gap="12" cross="center"><text size="sm" foreground="text_muted">Tap interval</text><slider key="tap-interval" grow="1" size="sm" value="{(doubleTapWindowMs - 200) / 300}" disabled="{not doubleTapEnabled or isBusy}" on-change="set_double_tap_interval" label="{tapIntervalLabel}"/><text width="54" size="sm"><span mono="true">{round(doubleTapWindowMs)} ms</span></text></row>
                  </column>
                </column>
                <separator/>
                <column gap="10">
                  <row gap="12" cross="center"><column grow="1" gap="2"><text>Paste automatically</text><text size="sm" foreground="text_muted">Into your source app</text></column><switch size="sm" checked="{pasteAutomatically}" disabled="{isBusy}" on-toggle="toggle_paste" label="Paste automatically"/></row>
                  <row gap="12" cross="center"><column grow="1" gap="2"><text>Show capsule</text><text size="sm" foreground="text_muted">Floating recording controls</text></column><switch size="sm" checked="{overlayEnabled}" disabled="{isBusy}" on-toggle="toggle_overlay" label="Show capsule"/></row>
                  <row gap="12" cross="center"><column grow="1" gap="2"><text>Launch at Login</text><text size="sm" foreground="text_muted" wrap="true">{loginStatusText}</text></column><switch size="sm" checked="{launchAtLogin}" disabled="{loginStatus == 'checking' or isBusy}" on-toggle="toggle_launch_at_login" label="Launch at Login"/></row>
                </column>
                <row cross="center" gap="6"><text size="sm" foreground="text_muted">On-device speech · No transcript history</text><spacer grow="1"/><if test="{hasImmediateResult}"><if test="{immediateResultKind == 'shown'}"><button size="sm" on-press="copy_immediate_result">Copy Final Text</button></if><button size="sm" variant="ghost" on-press="dismiss_result">Dismiss</button></if></row>
                <if test="{hotkeyCaptureActive or hasHotkeyCandidate or hasHotkeyWarning}">
                  <dialog label="Your dictation shortcut" on-dismiss="cancel_hotkey_capture">
                    <column padding="20" gap="12">
                      <text><span weight="medium" scale="1.4">Your dictation shortcut</span></text>
                      <text foreground="text_muted" wrap="true">Your current shortcut stays active until you choose a replacement.</text>
                      <toggle-group gap="8" label="Shortcut presets"><toggle-button size="sm" autofocus="true" selected="{hotkeyChoice == 'command_shift'}" on-toggle="choose_command_shift">Command + Shift</toggle-button><toggle-button size="sm" selected="{hotkeyChoice == 'control_option'}" on-toggle="choose_control_option">Control + Option</toggle-button></toggle-group>
                      <if test="{hotkeyCaptureActive}"><text><span weight="medium">Press your shortcut now</span></text><text foreground="text_muted" wrap="true">Press and release Fn/Globe, an F-key, or a key combination.</text><row><spacer grow="1"/><button size="sm" variant="ghost" on-press="cancel_hotkey_capture">Cancel</button></row></if>
                      <if test="{hasHotkeyCandidate}"><text>You pressed: <span mono="true">{hotkeyCandidateDisplay}</span></text><if test="{hasHotkeyWarning}"><text wrap="true">{hotkeyCandidateWarning}</text></if><row gap="8"><button size="sm" variant="ghost" on-press="cancel_hotkey_capture">Try Something Else</button><spacer grow="1"/><button size="sm" variant="primary" on-press="confirm_hotkey_candidate" disabled="{not hotkeyCandidateValid}">Use This Shortcut</button></row></if>
                      <if test="{not hotkeyCaptureActive and not hasHotkeyCandidate}"><text wrap="true">{hotkeyCandidateWarning}</text><row gap="8"><button size="sm" variant="ghost" on-press="cancel_hotkey_capture">Cancel</button><spacer grow="1"/><button size="sm" on-press="request_input_monitoring">Open Input Monitoring</button><button size="sm" variant="primary" on-press="start_hotkey_capture">Try Again</button></row></if>
                    </column>
                  </dialog>
                </if>
              </if>

              <if test="{showPermissions}">
                <column background="surface" border-color="border" radius="lg">
                  <row padding="12"><text><span weight="medium" scale="1.4">Permissions</span></text><spacer grow="1"/><text size="sm" foreground="text_muted">Checked live with macOS</text></row>
                  <separator/>
                  <column padding="16" gap="12">
                    <row gap="12" cross="center"><if test="{microphonePermission}"><icon name="check-circle" foreground="success" width="20" height="20"/></if><else><icon name="alert" foreground="warning" width="20" height="20"/></else><column grow="1" gap="2"><text><span weight="medium">Microphone</span></text><text size="sm" foreground="text_muted" wrap="true">{permissionMicrophoneState}</text></column><if test="{not microphonePermission}"><button size="sm" on-press="request_microphone">Recover Microphone Access</button></if></row>
                    <row gap="12" cross="center"><if test="{accessibilityPermission}"><icon name="check-circle" foreground="success" width="20" height="20"/></if><else><icon name="alert" foreground="warning" width="20" height="20"/></else><column grow="1" gap="2"><text><span weight="medium">Accessibility</span></text><text size="sm" foreground="text_muted" wrap="true">{permissionAccessibilityState}</text></column><if test="{not accessibilityPermission}"><button size="sm" on-press="request_accessibility">Recover Paste Access</button></if></row>
                    <row gap="12" cross="center"><if test="{inputMonitoringPermission}"><icon name="check-circle" foreground="success" width="20" height="20"/></if><else><icon name="alert" foreground="warning" width="20" height="20"/></else><column grow="1" gap="2"><text><span weight="medium">Input Monitoring</span></text><text size="sm" foreground="text_muted" wrap="true">{permissionInputState}</text></column><if test="{not inputMonitoringPermission}"><button size="sm" on-press="request_input_monitoring">Recover Shortcut Access</button></if></row>
                    <text foreground="text_muted" wrap="true">Without Microphone, recording is blocked. Without Input Monitoring, use manual Start. Without Accessibility, final text is copied.</text>
                  </column>
                </column>
              </if>

              <if test="{showModels}">
                <column background="surface" border-color="border" radius="lg">
                  <row padding="12"><text><span weight="medium" scale="1.4">Local models</span></text><spacer grow="1"/><button size="sm" icon="plus" on-press="choose_local_model">Add Local Model…</button></row>
                  <separator/>
                  <column padding="16" gap="8">
                    <text size="sm" foreground="text_muted" wrap="true">Speech recognition runs on this Mac. Only models on Friday’s reviewed production allowlist can be installed.</text>
                    <if test="{isBusy}"><text wrap="true">Finish or cancel dictation before changing models.</text></if>
                  </column>
                </column>
                <if test="{hfResolved}">
                  <column background="surface" border-color="border" radius="lg">
                    <column padding="16" gap="8">
                      <row><text><span mono="true">unverified candidate</span></text><spacer grow="1"/><text foreground="text_muted"><span mono="true">{hfResolvedProvider}</span></text></row>
                      <text wrap="true">{hfResolvedIdentifier}</text>
                      <text>{hfResolvedLicense} · {hfResolvedSize}</text>
                      <text foreground="text_muted"><span mono="true">rev {hfResolvedRevision}</span></text>
                      <text foreground="text_muted" wrap="true">Artifact {hfResolvedArtifact} · Attribution {hfResolvedAttribution}</text>
                      <if test="{hfResolvedAllowlisted}"><text wrap="true">This exact revision, artifact, byte count, and SHA-256 match a reviewed Friday production manifest. Only after the hash matches may Friday’s in-process GGUF runtime open it.</text><row gap="12" cross="center"><text grow="1" wrap="true">Authorize this exact allowlisted download</text><switch size="sm" checked="{hfResolvedConfirmed}" on-toggle="toggle_hf_download_confirmation" label="Authorize this exact allowlisted download"/></row><row><button size="sm" variant="ghost" on-press="clear_hf_candidate">Choose Another Repository</button><spacer grow="1"/><button size="sm" variant="primary" on-press="download_resolved_hf" disabled="{not hfResolvedConfirmed or modelDownloadActive or isBusy}">Download Allowlisted Model</button></row></if>
                      <else><text wrap="true">Metadata only. This artifact is not on Friday’s production allowlist, so Friday will not download, parse, runtime-probe, recognize with, or activate its GGUF bytes.</text><button size="sm" variant="ghost" on-press="clear_hf_candidate">Choose Another Repository</button></else>
                    </column>
                  </column>
                </if>
                <else>
                  <if test="{hasActiveModel}"><column background="surface" border-color="border" radius="lg"><row padding="12"><text><span mono="true">● active</span></text><spacer grow="1"/><text foreground="text_muted">{activeModelSource}</text></row><separator/><row padding="16" gap="12" cross="center"><column grow="1" gap="2"><text><span weight="medium">{activeModelName}</span></text><text foreground="text_muted">{activeModelLicense} · {activeModelLanguages} · {activeModelSizeText}</text></column><column gap="8"><button size="sm" variant="outline" on-press="remove_model_reference" disabled="{isBusy}">Remove from Friday</button><if test="{isDefaultModelActive}"><button size="sm" variant="destructive" on-press="delete_managed_model" disabled="{isBusy}">Delete Friday’s Copy</button></if></column></row></column></if><else><column background="surface" border-color="border" radius="lg"><column padding="16" gap="6"><text><span weight="medium">No active model.</span></text><text foreground="text_muted" wrap="true">Select or add one below.</text></column></column></else>
                  <column background="surface" border-color="border" radius="lg">
                    <column padding="16" gap="12">
                      <for each="availableModels" as="m"><row gap="12" cross="center"><text foreground="text_muted"><span mono="true">○</span></text><column grow="1" gap="2"><text><span weight="medium">{m.name}</span></text><text foreground="text_muted">{m.source}</text><text foreground="text_muted">{m.license} · {m.languages} · {m.size}</text></column><column gap="8"><button size="sm" on-press="select_model:{m.modelKey}" disabled="{isBusy}">Select</button><button size="sm" variant="ghost" on-press="remove_model:{m.modelKey}" disabled="{isBusy}">Remove</button><if test="{m.managed}"><button size="sm" variant="destructive" on-press="delete_model:{m.modelKey}" disabled="{isBusy}">Delete Copy</button></if></column></row></for>
                      <if test="{not defaultModelInstalled}"><row gap="12" cross="center"><text foreground="text_muted"><span mono="true">○</span></text><column grow="1" gap="2"><text><span weight="medium">Parakeet TDT 0.6B v3</span></text><text foreground="text_muted">25 languages · CC-BY-4.0 · 714 MB</text></column><column gap="8"><if test="{modelDownloadState == 'idle'}"><button size="sm" variant="primary" on-press="retry_model_download">Download Verified Model</button></if><if test="{modelDownloadActive}"><button size="sm" on-press="cancel_model_download">Cancel Download</button></if><if test="{modelDownloadPaused}"><button size="sm" variant="primary" on-press="retry_model_download">Resume Download</button></if><if test="{modelDownloadFailed}"><button size="sm" variant="primary" on-press="retry_model_download">Retry Download</button></if></column></row><if test="{modelTotalBytes > 0}"><column gap="6"><progress value="{modelDownloadedBytes / modelTotalBytes}" label="Model download progress"/><text foreground="text_muted"><span mono="true">{modelDownloadedBytesLabel} / {modelTotalBytesLabel} bytes</span></text></column></if></if>
                      <row gap="12" cross="center"><column grow="1" gap="2"><text><span weight="medium">Parakeet CTC 1.1B</span></text><text foreground="text_muted">English · CC-BY-4.0 · 1.18 GB</text></column><button size="sm" on-press="choose_parakeet_ctc" disabled="{modelDownloadActive or isBusy}">Use Parakeet CTC repository</button></row>
                      <text foreground="text_muted" wrap="true">The larger English model is offered for metadata inspection. It remains unavailable for installation until Friday ships an exact reviewed artifact on the production allowlist.</text>
                      <text><span weight="medium">Inspect a Hugging Face repository</span></text>
                      <text-field size="sm" text="{hfDraft}" on-input="hf_draft_edit" placeholder="owner/repository" label="Hugging Face model identifier"/>
                      <row gap="12" cross="center"><text grow="1" wrap="true">Allow Friday to contact Hugging Face and resolve public metadata</text><switch size="sm" checked="{hfSourceConfirmed}" on-toggle="toggle_hf_source_confirmation" label="Allow Friday to contact Hugging Face and resolve public metadata"/></row>
                      <row><text foreground="text_muted" grow="1" wrap="true">Repository metadata never grants parser access.</text><button size="sm" on-press="add_hugging_face_model" disabled="{not hfSourceConfirmed or modelDownloadActive or isBusy}">Inspect Candidate Metadata</button></row>
                    </column>
                  </column>
                </else>
                <column background="surface" border-color="border" radius="lg">
                  <row padding="12" gap="8"><text foreground="text_muted" grow="1"><span mono="true">{round(modelCount)} {plural(round(modelCount), 'model', 'models')} · {managedModelSizeText} managed</span></text><button size="sm" variant="ghost" on-press="cleanup_model_downloads" disabled="{modelDownloadActive}">Clean Partial Downloads</button></row>
                  <separator/>
                  <row padding="12"><text foreground="text_muted" wrap="true">{modelDownloadMessage}</text></row>
                </column>
              </if>

              <if test="{showDiagnostics}">
                <column background="surface" border-color="border" radius="lg">
                  <row padding="12"><text><span weight="medium" scale="1.4">Safe diagnostics</span></text></row>
                  <separator/>
                  <column padding="16" gap="12">
                    <text foreground="text_muted" wrap="true">Never audio, transcript, clipboard, document name, or raw path.</text>
                    <code source="{diagnostics}" language="json" wrap="true"/>
                    <row gap="8"><button size="sm" on-press="refresh_diagnostics">Refresh</button><button size="sm" on-press="copy_diagnostics">Copy Diagnostics</button><button size="sm" variant="primary" on-press="export_diagnostics">Export and Reveal</button><if test="{hasDiagnosticsExport}"><button size="sm" variant="ghost" on-press="reveal_diagnostics">Reveal Last Export</button></if></row>
                    <if test="{automationSceneActive}"><button size="sm" variant="ghost" on-press="automation_hotkey_probe_now">Run Automation Hotkey Probe</button></if>
                  </column>
                </column>
              </if>
            </column>
          </scroll>
        </row>
      </else>
    </else>
  </else>
</column>
