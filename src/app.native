<column gap="16" padding="24" main="center" cross="stretch">
  <text size="heading">FridayHost bridge</text>
  <text wrap="true">Native SDK deterministic core → Zig host binding → Objective-C++ AppKit adapter.</text>
  <card>
    <column gap="8" padding="16">
      <text>State: {bridgeState}</text>
      <text wrap="true">{bridgeDetail}</text>
    </column>
  </card>
  <button variant="primary" on-press="run_spike">Run bridge spike</button>
</column>
