<scroll>
  <column gap="16" padding="20">
    <row gap="8" cross="center">
      <text size="heading" grow="1">Friday</text>
      <badge>{workflowName}</badge>
    </row>
    <text wrap="true">{workflowDetail}</text>

    <card>
      <column gap="8" padding="12">
        <text>Setup</text>
        <text wrap="true">{permissionSummary}</text>
        <text wrap="true">{modelSummary}</text>
        <text wrap="true">{ambientDetail}</text>
        <row gap="8">
          <button on-press="request_microphone">Grant Microphone</button>
          <button on-press="request_accessibility">Grant Accessibility</button>
          <button on-press="request_input_monitoring">Grant Input Monitoring</button>
        </row>
        <row gap="8">
          <button variant="primary" on-press="confirm_hotkey">Confirm Command-Shift</button>
          <button on-press="complete_onboarding">Complete onboarding</button>
        </row>
        <text>Permissions loaded: {permissionsLoaded} · models loaded: {modelsLoaded}</text>
        <text>Mic {microphonePermission} · AX {accessibilityPermission} · Input {inputMonitoringPermission}</text>
        <text>Model ready {modelReady} · selected model {selectedModelKey} · hotkey {hotkeyConfirmed}</text>
        <text>Onboarding {onboardingComplete} · limited mode {limitedModeAccepted}</text>
      </column>
    </card>

    <card>
      <column gap="8" padding="12">
        <text>Dictation</text>
        <if test="{isReady}">
          <button variant="primary" on-press="start_recording">Start recording</button>
        </if>
        <if test="{isRecording}">
          <button variant="primary" on-press="stop_recording">Stop recording</button>
        </if>
        <if test="{isBusy}">
          <button variant="destructive" on-press="cancel_active">Cancel active session</button>
        </if>
        <if test="{canRetry}">
          <button on-press="retry_transcription">Retry transcription</button>
        </if>
        <if test="{isLocked}">
          <text>Locked recording is active.</text>
        </if>
        <button on-press="dismiss_failure">Dismiss failure</button>
        <button on-press="dismiss_result">Dismiss immediate result</button>
        <text>Session {sessionId} · generation {generation} · captured frames {capturedFrames}</text>
        <text>Pressed {pressedAtMs} · last quick release {lastQuickReleaseAtMs}</text>
        <text>Immediate result {hasImmediateResult} · {immediateResultKind}</text>
        <text wrap="true">{immediateResultMessage}</text>
      </column>
    </card>

    <card>
      <column gap="8" padding="12">
        <text>Preferences</text>
        <switch checked="{doubleTapEnabled}" on-toggle="toggle_double_tap">Double-tap lock</switch>
        <switch checked="{overlayEnabled}" on-toggle="toggle_overlay">Show recording overlay</switch>
        <switch checked="{pasteAutomatically}" on-toggle="toggle_paste">Paste automatically when possible</switch>
        <switch checked="{launchAtLogin}" on-toggle="toggle_launch_at_login">Launch at login</switch>
        <text>Double-tap window {doubleTapWindowMs} ms · minimum hold {minimumHoldMs} ms</text>
        <text>Dictation is local. Network access is used only for model downloads.</text>
      </column>
    </card>
  </column>
</scroll>
