<column background="background" grow="1">
  <if test="{showUnsupported}">
    <column grow="1" padding="28" gap="12">
      <spacer grow="1"/>
      <text><span mono="true">unsupported Mac</span></text>
      <text><span weight="medium">Apple Silicon required</span></text>
      <text wrap="true">Friday runs its speech engine locally and requires an Apple Silicon Mac with macOS 14 or later.</text>
      <separator/>
      <row><text foreground="text_muted">Architecture</text><spacer grow="1"/><text><span mono="true">{platformArchitecture}</span></text></row>
      <row><text foreground="text_muted">System</text><spacer grow="1"/><text><span mono="true">macOS {platformOSVersion}</span></text></row>
      <separator/>
      <text foreground="text_muted" wrap="true">{platformMessage} Setup, model downloads, and recording are disabled.</text>
      <spacer grow="1"/>
    </column>
  </if>
  <else>
    <if test="{showOverlayPreview}">
      <column grow="1" cross="center" background="surface_subtle">
        <spacer grow="1"/>
        <column width="560" background="surface" border-color="border" radius="sm">
          <row padding="12" cross="center" gap="10"><text><span mono="true">friday · voice</span></text><spacer grow="1"/><text><span mono="true">● live</span></text><text foreground="text_muted">Recording capsule preview</text></row>
          <separator/>
          <row padding="18" gap="12" cross="center">
            <text><span mono="true">{waveformGlyph}</span></text>
            <column grow="1" gap="2"><text>Locked</text><text foreground="text_muted"><span mono="true">{elapsedLabel}</span></text></column>
            <button size="sm" variant="primary" on-press="stop_recording">Stop</button>
            <button size="sm" variant="ghost" on-press="dismiss_overlay_preview">Hide</button>
            <button size="sm" variant="destructive" on-press="cancel_active">Cancel</button>
          </row>
          <separator/>
          <row padding="12"><text foreground="text_muted">Hide removes the capsule only. Stop transcribes. Cancel discards.</text></row>
        </column>
        <spacer grow="1"/>
      </column>
    </if>
    <else>
      <if test="{showOnboarding}">
        <column grow="1">
          <row padding="10" gap="8" cross="center" background="surface_subtle">
            <text><span weight="medium">Setup</span></text>
            <spacer grow="1"/>
            <text foreground="text_muted"><span mono="true">{onboardingStepLabel}</span></text>
          </row>
          <separator/>
          <scroll grow="1">
            <column padding="24" gap="12">
              <if test="{onboardingStep == 0}">
                <text><span weight="medium">Your voice stays here.</span></text>
                <text wrap="true">Hold one shortcut, speak, and put the final words back where you started.</text>
                <separator/>
                <row gap="18"><text foreground="text_muted"><span mono="true">01</span></text><column gap="3"><text><span weight="medium">Audio never leaves this Mac</span></text><text foreground="text_muted">The speech engine runs locally.</text></column></row>
                <separator/>
                <row gap="18"><text foreground="text_muted"><span mono="true">02</span></text><column gap="3"><text><span weight="medium">Only the final words are returned</span></text><text foreground="text_muted">No partial transcript. No history.</text></column></row>
                <separator/>
                <row gap="18"><text foreground="text_muted"><span mono="true">03</span></text><column gap="3"><text><span weight="medium">Every fallback is explicit</span></text><text foreground="text_muted">If exact paste is unsafe, Friday tells you it copied instead.</text></column></row>
                <spacer height="8"/>
                <row><spacer grow="1"/><button size="sm" variant="primary" on-press="onboarding_next">Set up Friday</button></row>
              </if>

              <if test="{onboardingStep == 1}">
                <text><span weight="medium">Three permissions. Three jobs.</span></text>
                <text foreground="text_muted">Friday reports what macOS allows, not what it requested.</text>
                <separator/>
                <row gap="16" cross="center"><if test="{microphonePermission}"><text><span mono="true">●</span></text></if><else><text><span mono="true">○</span></text></else><column grow="1" gap="2"><text>Microphone</text><text foreground="text_muted">{permissionMicrophoneState}</text></column><if test="{not microphonePermission}"><button size="sm" on-press="request_microphone">Allow Microphone</button></if></row>
                <separator/>
                <row gap="16" cross="center"><if test="{accessibilityPermission}"><text><span mono="true">●</span></text></if><else><text><span mono="true">○</span></text></else><column grow="1" gap="2"><text>Accessibility</text><text foreground="text_muted">Return final text to the exact source app.</text></column><if test="{not accessibilityPermission}"><button size="sm" on-press="request_accessibility">Open Accessibility</button></if></row>
                <separator/>
                <row gap="16" cross="center"><if test="{inputMonitoringPermission}"><text><span mono="true">●</span></text></if><else><text><span mono="true">○</span></text></else><column grow="1" gap="2"><text>Input Monitoring</text><text foreground="text_muted" wrap="true">Hear the shortcut while another app is focused.</text></column><if test="{not inputMonitoringPermission}"><button size="sm" on-press="request_input_monitoring">Open Input Monitoring</button></if></row>
                <if test="{not inputMonitoringPermission or not accessibilityPermission}"><row padding="10" gap="10" cross="center" background="surface_subtle" border-color="border"><column grow="1" gap="2"><text><span weight="medium">Limited mode</span></text><text foreground="text_muted" wrap="true">Manual Start works without Input Monitoring. Without Accessibility, final text is copied. Status refreshes automatically.</text></column><button size="sm" variant="ghost" on-press="accept_limited_mode">Use limited mode</button></row></if>
                <row gap="8"><button size="sm" variant="ghost" on-press="onboarding_back">Back</button><spacer grow="1"/><button size="sm" variant="primary" on-press="onboarding_next" disabled="{not microphonePermission or ((not inputMonitoringPermission or not accessibilityPermission) and not limitedModeAccepted)}">Continue</button></row>
              </if>

              <if test="{onboardingStep == 2}">
                <text><span weight="medium">One gesture between thought and text.</span></text>
                <text foreground="text_muted" wrap="true">Choose a preset, or press and release Fn/Globe by itself. Ordinary typing and known system shortcuts are rejected.</text>
                <column background="surface" border-color="border">
                  <row padding="12"><if test="{hotkeyConfirmed}"><text><span mono="true">● active</span></text></if><else><text foreground="text_muted"><span mono="true">shortcut / unset</span></text></else><spacer grow="1"/><text foreground="text_muted">global control</text></row>
                  <separator/>
                  <column padding="20" gap="14">
                    <text><span mono="true">{hotkeyLabel}</span></text>
                    <toggle-group gap="8" label="Shortcut presets"><toggle-button size="sm" selected="{hotkeyChoice == 'command_shift'}" on-toggle="choose_command_shift">Command + Shift</toggle-button><toggle-button size="sm" selected="{hotkeyChoice == 'control_option'}" on-toggle="choose_control_option">Control + Option</toggle-button></toggle-group>
                    <button size="sm" variant="outline" on-press="start_hotkey_capture" disabled="{hotkeyCaptureActive}">Record another shortcut…</button>
                  </column>
                </column>
                <if test="{hotkeyCaptureActive}"><column padding="16" gap="8" background="surface_subtle" border-color="border"><text><span weight="medium">Press your shortcut now</span></text><text foreground="text_muted" wrap="true">For Fn/Globe alone, press once and release. An F-key or any modified key also works.</text><button size="sm" variant="ghost" on-press="cancel_hotkey_capture">Cancel</button></column></if>
                <if test="{hasHotkeyCandidate}"><column padding="14" gap="8" background="surface_subtle" border-color="border"><text foreground="text_muted">You pressed</text><text><span mono="true">{hotkeyCandidateDisplay}</span></text><if test="{hasHotkeyWarning}"><text wrap="true">{hotkeyCandidateWarning}</text></if><row gap="8"><button size="sm" variant="primary" on-press="confirm_hotkey_candidate" disabled="{not hotkeyCandidateValid}">Use This Shortcut</button><button size="sm" variant="ghost" on-press="cancel_hotkey_capture">Try Something Else</button></row></column></if>
                <if test="{hotkeyConfirmed}"><row gap="12" cross="center"><text><span mono="true">●</span></text><text grow="1">{hotkeyLabel} is active.</text></row></if>
                <row gap="8"><button size="sm" variant="ghost" on-press="onboarding_back">Back</button><spacer grow="1"/><button size="sm" variant="primary" on-press="onboarding_next" disabled="{not hotkeyConfirmed and not limitedModeAccepted}">Continue</button></row>
              </if>

              <if test="{onboardingStep == 3}">
                <text><span weight="medium">Run the model here.</span></text>
                <text foreground="text_muted" wrap="true">Parakeet turns speech into final text on this Mac. The verified download is about 714 MB.</text>
                <column background="surface" border-color="border">
                  <row padding="12"><text><span mono="true">nvidia / parakeet</span></text><spacer grow="1"/><text foreground="text_muted"><span mono="true">{modelDownloadState}</span></text></row>
                  <separator/>
                  <column padding="20" gap="12">
                    <row gap="12" cross="center"><if test="{modelReady}"><text><span mono="true">●</span></text></if><else><text foreground="text_muted"><span mono="true">○</span></text></else><column grow="1"><text>Parakeet TDT 0.6B v3</text><text foreground="text_muted">25 languages · CC-BY-4.0 · 714 MB</text></column></row>
                    <if test="{modelDownloadState == 'idle'}"><row gap="8"><button size="sm" variant="primary" on-press="retry_model_download">Download Parakeet</button><button size="sm" on-press="choose_local_model">Choose Local Model…</button></row></if>
                    <if test="{modelDownloadActive}"><progress value="{modelDownloadedBytes / modelTotalBytes}" label="Parakeet download progress"/><text foreground="text_muted"><span mono="true">{modelDownloadedBytesLabel} / {modelTotalBytesLabel} bytes</span></text><button size="sm" variant="outline" on-press="cancel_model_download">Cancel Download</button></if>
                    <if test="{modelDownloadPaused}"><text>A verified partial is ready.</text><progress value="{modelDownloadedBytes / modelTotalBytes}" label="Paused Parakeet download progress"/><text foreground="text_muted"><span mono="true">{modelDownloadedBytesLabel} / {modelTotalBytesLabel} bytes downloaded</span></text><row gap="8"><button size="sm" variant="primary" on-press="retry_model_download">Resume Download</button><button size="sm" on-press="choose_local_model">Choose Local Model…</button><button size="sm" variant="ghost" on-press="cleanup_model_downloads">Remove Partial Download</button></row></if>
                    <if test="{modelDownloadFailed}"><text>The download stopped before verification.</text><row gap="8"><button size="sm" variant="primary" on-press="retry_model_download">Retry Download</button><button size="sm" on-press="choose_local_model">Choose Local Model…</button><button size="sm" variant="ghost" on-press="cleanup_model_downloads" disabled="{modelDownloadActive}">Remove Partial Download</button></row></if>
                    <if test="{modelReady}"><text>Ready for local transcription</text></if>
                    <text foreground="text_muted" wrap="true">{modelDownloadMessage}</text>
                  </column>
                </column>
                <row gap="8"><button size="sm" variant="ghost" on-press="onboarding_back" disabled="{modelDownloadActive}">Back</button><spacer grow="1"/><button size="sm" variant="primary" on-press="complete_onboarding" disabled="{not canCompleteOnboarding}">Finish Setup</button></row>
              </if>
            </column>
          </scroll>
        </column>
      </if>
      <else>
        <column grow="1">
          <row padding="8" gap="6" cross="center" background="surface_subtle">
            <toggle-group gap="4" label="Friday sections"><toggle-button size="sm" selected="{showSettings}" on-toggle="show_settings">Controls</toggle-button><toggle-button size="sm" selected="{showModels}" on-toggle="show_models">Models</toggle-button><toggle-button size="sm" selected="{showPermissions}" on-toggle="show_permissions">Access</toggle-button><toggle-button size="sm" selected="{showDiagnostics}" on-toggle="show_diagnostics">Diagnostics</toggle-button></toggle-group>
          </row>
          <separator/>
            <column padding="12" gap="8" background="surface">
              <row gap="12" cross="center">
                <if test="{isReady}"><text><span mono="true">●</span></text></if><else><text foreground="text_muted"><span mono="true">●</span></text></else>
                <column grow="1" gap="2"><text><span weight="medium">{workflowName}</span></text><text foreground="text_muted" wrap="true">{workflowDetail}</text></column>
                <if test="{isReady}"><text><span mono="true">{hotkeyLabel}</span></text><button size="sm" variant="primary" on-press="start_recording">Start Recording</button></if>
                <if test="{isRecording}"><text><span mono="true">{elapsedLabel}</span></text><button size="sm" variant="primary" on-press="stop_recording">Stop Recording</button></if>
                <if test="{isBusy}"><button size="sm" variant="destructive" on-press="cancel_active">Cancel</button></if>
              </row>
              <if test="{isRecording}"><progress value="{elapsedMilliseconds / 600000}" label="Recording duration"/></if>
            </column>
            <if test="{isFailed}"><column padding="16" gap="8" background="surface_subtle"><text><span mono="true">attention required</span></text><text><span weight="medium">Model: {failureModelName}</span></text><text wrap="true">{failureDetail}</text><row gap="8"><if test="{canRetry}"><button size="sm" variant="primary" on-press="retry_transcription">Retry Transcription</button></if><if test="{hasImmediateResult and immediateResultKind == 'shown'}"><button size="sm" on-press="copy_immediate_result">Copy Final Text</button></if><button size="sm" on-press="copy_diagnostics_fresh">Copy Diagnostics</button><button size="sm" on-press="show_models">Change Model</button><button size="sm" variant="ghost" on-press="dismiss_failure">Dismiss</button></row></column></if>
            <separator/>
            <scroll grow="1">
              <column padding="16" gap="10">
                <if test="{showSettings}">
                  <row cross="center"><text><span weight="medium">Input</span></text></row>
                  <separator/>
                  <row gap="14" cross="center"><if test="{microphonePermission}"><text><span mono="true">{waveformGlyph}</span></text></if><else><text foreground="text_muted"><span mono="true">{waveformGlyph}</span></text></else><column grow="1"><text wrap="true">{microphoneDisplayName}</text><text foreground="text_muted">{microphoneDetail}</text></column><button size="sm" on-press="refresh_microphone">Check Microphone</button></row>
                  <separator/>
                  <row gap="12" cross="center"><column grow="1" gap="3"><text><span mono="true">{hotkeyLabel}</span></text><text foreground="text_muted">Hold to talk · double-tap to lock</text></column><button size="sm" on-press="start_hotkey_capture" disabled="{hotkeyCaptureActive}">Change Shortcut…</button></row>
                  <toggle-group gap="8" label="Shortcut presets"><toggle-button size="sm" selected="{hotkeyChoice == 'command_shift'}" on-toggle="choose_command_shift">Command + Shift</toggle-button><toggle-button size="sm" selected="{hotkeyChoice == 'control_option'}" on-toggle="choose_control_option">Control + Option</toggle-button></toggle-group>
                  <if test="{hotkeyCaptureActive}"><column padding="12" gap="6" background="surface_subtle" border-color="border"><text><span weight="medium">Press your shortcut now</span></text><text foreground="text_muted" grow="1">Fn/Globe, an F-key, or any key combination.</text><button size="sm" variant="ghost" on-press="cancel_hotkey_capture">Cancel</button></column></if>
                  <if test="{hasHotkeyCandidate}"><column padding="12" gap="8" background="surface_subtle" border-color="border"><text>You pressed: <span mono="true">{hotkeyCandidateDisplay}</span></text><if test="{hasHotkeyWarning}"><text wrap="true">{hotkeyCandidateWarning}</text></if><row gap="8"><button size="sm" variant="primary" on-press="confirm_hotkey_candidate" disabled="{not hotkeyCandidateValid}">Use This Shortcut</button><button size="sm" variant="ghost" on-press="cancel_hotkey_capture">Try Something Else</button></row></column></if>
                  <row cross="center"><switch size="sm" checked="{doubleTapEnabled}" on-toggle="toggle_double_tap">Double-tap to lock recording</switch><spacer grow="1"/><toggle-group gap="6" label="Double-tap timing"><toggle-button size="sm" selected="{doubleTapWindowMs == 250}" on-toggle="set_double_tap_fast">250 ms</toggle-button><toggle-button size="sm" selected="{doubleTapWindowMs == 300}" on-toggle="set_double_tap_balanced">300 ms</toggle-button><toggle-button size="sm" selected="{doubleTapWindowMs == 400}" on-toggle="set_double_tap_deliberate">400 ms</toggle-button></toggle-group></row>
                  <separator/>
                  <row cross="center"><text><span weight="medium">Output</span></text></row>
                  <separator/>
                  <row gap="14" cross="center"><text foreground="text_muted" grow="1">Final text lands where you were typing</text><switch size="sm" checked="{pasteAutomatically}" on-toggle="toggle_paste">Paste automatically</switch></row>
                  <row gap="14" cross="center"><text foreground="text_muted" grow="1">Floating transport while you talk</text><switch size="sm" checked="{overlayEnabled}" on-toggle="toggle_overlay">Show capsule</switch></row>
                  <row gap="14" cross="center"><text foreground="text_muted" grow="1"><span mono="true">{loginStatusText}</span></text><switch size="sm" checked="{launchAtLogin}" disabled="{loginStatus == 'checking'}" on-toggle="toggle_launch_at_login">Launch at Login</switch></row>
                  <separator/>
                  <text foreground="text_muted" wrap="true">Audio never leaves this Mac. Network runs only for model downloads you start.</text>
                  <if test="{hasImmediateResult}"><column padding="12" gap="8" background="surface_subtle" border-color="border"><text><span weight="medium">Latest result</span></text><text wrap="true">{immediateResultMessage}</text><row gap="8"><if test="{immediateResultKind == 'shown'}"><button size="sm" on-press="copy_immediate_result">Copy Final Text</button></if><button size="sm" variant="ghost" on-press="dismiss_result">Dismiss</button></row></column></if>
                  <if test="{automationSceneActive}"><button size="sm" variant="ghost" on-press="automation_hotkey_probe_now">Run Automation Hotkey Probe</button></if>
                </if>

                <if test="{showPermissions}">
                  <row cross="center"><text><span weight="medium">Permissions</span></text><spacer grow="1"/><text foreground="text_muted">Live macOS state</text></row>
                  <separator/>
                  <row gap="12" cross="center"><if test="{microphonePermission}"><text><span mono="true">●</span></text></if><else><text><span mono="true">○</span></text></else><column grow="1"><text>Microphone</text><text foreground="text_muted">{permissionMicrophoneState}</text></column><if test="{not microphonePermission}"><button size="sm" on-press="request_microphone">Recover Microphone Access</button></if></row>
                  <separator/>
                  <row gap="12" cross="center"><if test="{accessibilityPermission}"><text><span mono="true">●</span></text></if><else><text><span mono="true">○</span></text></else><column grow="1"><text>Accessibility</text><text foreground="text_muted">{permissionAccessibilityState}</text></column><if test="{not accessibilityPermission}"><button size="sm" on-press="request_accessibility">Recover Paste Access</button></if></row>
                  <separator/>
                  <row gap="12" cross="center"><if test="{inputMonitoringPermission}"><text><span mono="true">●</span></text></if><else><text><span mono="true">○</span></text></else><column grow="1"><text>Input Monitoring</text><text foreground="text_muted">{permissionInputState}</text></column><if test="{not inputMonitoringPermission}"><button size="sm" on-press="request_input_monitoring">Recover Shortcut Access</button></if></row>
                  <separator/>
                  <text foreground="text_muted" wrap="true">Without Microphone, recording is blocked. Without Input Monitoring, use manual Start. Without Accessibility, final text is copied.</text>
                </if>

                <if test="{showModels}">
                  <row cross="center"><text><span weight="medium">Local models</span></text><spacer grow="1"/><button size="sm" on-press="choose_local_model">Add Local Model…</button></row>
                  <text foreground="text_muted" wrap="true">Only exact artifacts from Friday’s reviewed production allowlist can be opened by the local GGUF runtime.</text>
                  <if test="{isBusy}"><text>Finish or cancel dictation before changing models.</text></if>
                  <separator/>
                  <if test="{hfResolved}">
                    <column gap="10">
                      <row><text><span mono="true">unverified candidate</span></text><spacer grow="1"/><text foreground="text_muted"><span mono="true">{hfResolvedProvider}</span></text></row>
                      <text wrap="true">{hfResolvedIdentifier}</text>
                      <text>{hfResolvedLicense} · {hfResolvedSize}</text>
                      <text foreground="text_muted"><span mono="true">rev {hfResolvedRevision}</span></text>
                      <text foreground="text_muted" wrap="true">Artifact {hfResolvedArtifact} · Attribution {hfResolvedAttribution}</text>
                      <if test="{hfResolvedAllowlisted}"><text wrap="true">This exact revision, artifact, byte count, and SHA-256 match a reviewed Friday production manifest. Only after the hash matches may Friday’s in-process GGUF runtime open it.</text><switch size="sm" checked="{hfResolvedConfirmed}" on-toggle="toggle_hf_download_confirmation">Authorize this exact allowlisted download</switch><row><button size="sm" variant="ghost" on-press="clear_hf_candidate">Choose Another Repository</button><spacer grow="1"/><button size="sm" variant="primary" on-press="download_resolved_hf" disabled="{not hfResolvedConfirmed or modelDownloadActive or isBusy}">Download Allowlisted Model</button></row></if>
                      <else><text wrap="true">Metadata only. This artifact is not on Friday’s production allowlist, so Friday will not download, parse, runtime-probe, recognize with, or activate its GGUF bytes.</text><button size="sm" variant="ghost" on-press="clear_hf_candidate">Choose Another Repository</button></else>
                    </column>
                  </if>
                  <else>
                    <if test="{hasActiveModel}"><column background="surface" border-color="border"><row padding="12"><text><span mono="true">● active</span></text><spacer grow="1"/><text foreground="text_muted">{activeModelSource}</text></row><separator/><row padding="16" gap="14" cross="center"><column grow="1" gap="3"><text>{activeModelName}</text><text>{activeModelLicense} · {activeModelLanguages} · {activeModelSizeText}</text></column><column gap="8"><button size="sm" variant="outline" on-press="remove_model_reference" disabled="{isBusy}">Remove from Friday</button><if test="{isDefaultModelActive}"><button size="sm" variant="destructive" on-press="delete_managed_model" disabled="{isBusy}">Delete Friday’s Copy</button></if></column></row></column></if><else><text>No active model. Select or add one below.</text></else>
                    <for each="availableModels" as="m"><separator/><row gap="14" cross="center"><text foreground="text_muted"><span mono="true">○</span></text><column grow="1"><text>{m.name}</text><text foreground="text_muted">{m.source}</text><text>{m.license} · {m.languages} · {m.size}</text></column><button size="sm" on-press="select_model:{m.modelKey}" disabled="{isBusy}">Select</button><button size="sm" variant="ghost" on-press="remove_model:{m.modelKey}" disabled="{isBusy}">Remove</button><if test="{m.managed}"><button size="sm" variant="destructive" on-press="delete_model:{m.modelKey}" disabled="{isBusy}">Delete Copy</button></if></row></for>
                    <if test="{not defaultModelInstalled}"><separator/><row gap="14" cross="center"><text foreground="text_muted"><span mono="true">○</span></text><column grow="1"><text>Parakeet TDT 0.6B v3</text><text foreground="text_muted">25 languages · CC-BY-4.0 · 714 MB</text></column><if test="{modelDownloadState == 'idle'}"><button size="sm" variant="primary" on-press="retry_model_download">Download Verified Model</button></if><if test="{modelDownloadActive}"><button size="sm" on-press="cancel_model_download">Cancel Download</button></if><if test="{modelDownloadPaused}"><button size="sm" variant="primary" on-press="retry_model_download">Resume Download</button></if><if test="{modelDownloadFailed}"><button size="sm" variant="primary" on-press="retry_model_download">Retry Download</button></if></row><if test="{modelTotalBytes > 0}"><progress value="{modelDownloadedBytes / modelTotalBytes}" label="Model download progress"/><text foreground="text_muted"><span mono="true">{modelDownloadedBytesLabel} / {modelTotalBytesLabel} bytes</span></text></if></if>
                    <separator/>
                    <row gap="16" cross="center"><column grow="1"><text>Parakeet CTC 1.1B</text><text foreground="text_muted">English · CC-BY-4.0 · 1.18 GB</text></column><button size="sm" on-press="choose_parakeet_ctc" disabled="{modelDownloadActive or isBusy}">Use Parakeet CTC repository</button></row>
                    <text foreground="text_muted" wrap="true">The larger English model is offered for metadata inspection. It remains unavailable for installation until Friday ships an exact reviewed artifact on the production allowlist.</text>
                    <separator/>
                    <text>Add from Hugging Face</text>
                    <text-field size="sm" text="{hfDraft}" on-input="hf_draft_edit" placeholder="owner/repository" label="Hugging Face model identifier"/>
                    <switch size="sm" checked="{hfSourceConfirmed}" on-toggle="toggle_hf_source_confirmation">Allow Friday to contact Hugging Face and resolve public metadata</switch>
                    <row><text foreground="text_muted" grow="1">Repository metadata never grants parser access.</text><button size="sm" on-press="add_hugging_face_model" disabled="{not hfSourceConfirmed or modelDownloadActive or isBusy}">Inspect Candidate Metadata</button></row>
                  </else>
                  <separator/>
                  <row gap="8"><text foreground="text_muted" grow="1"><span mono="true">{round(modelCount)} {plural(round(modelCount), 'model', 'models')} · {managedModelSizeText} managed</span></text><button size="sm" variant="ghost" on-press="cleanup_model_downloads" disabled="{modelDownloadActive}">Clean Partial Downloads</button></row>
                  <text foreground="text_muted">{modelDownloadMessage}</text>
                </if>

                <if test="{showDiagnostics}">
                  <row cross="center"><column grow="1" gap="2"><text><span weight="medium">Safe export</span></text><text foreground="text_muted" wrap="true">Never audio, transcript, clipboard, document name, or raw path.</text></column></row>
                  <separator/>
                  <code source="{diagnostics}" language="json" wrap="true"/>
                  <separator/>
                  <row gap="8"><button size="sm" on-press="refresh_diagnostics">Refresh</button><button size="sm" on-press="copy_diagnostics">Copy Diagnostics</button><button size="sm" variant="primary" on-press="export_diagnostics">Export and Reveal</button><if test="{hasDiagnosticsExport}"><button size="sm" variant="ghost" on-press="reveal_diagnostics">Reveal Last Export</button></if></row>
                </if>
              </column>
            </scroll>
        </column>
      </else>
    </else>
  </else>
</column>
