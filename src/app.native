<scroll>
  <column gap="12" padding="20">
    <text size="heading">Friday native interaction spikes</text>
    <text wrap="true">Production FridayHost paths: global input, exact-source delivery, overlay, bounded audio, embedded NeMo, and verified model storage.</text>
    <card>
      <column gap="6" padding="12">
        <text>Bridge: {bridgeState}</text>
        <text wrap="true">{detail}</text>
        <text wrap="true">Permissions: {permissions}</text>
      </column>
    </card>
    <row gap="8">
      <button variant="primary" on-press="confirm_hotkey">Confirm Command-Shift hotkey</button>
      <button on-press="probe_hotkey">Run global-input probe</button>
    </row>
    <text>Confirmed: {hotkeyConfirmed} · down: {hotkeyDown} · locked: {recordingLocked}</text>
    <text>Workflow: {workflow} · generation {generation} · recording {recordingActive}</text>
    <text>Session: {sessionId} · next {nextSessionId} · hold {minimumHoldMs} ms · double tap {doubleTapWindowMs} ms</text>
    <text>Events: {hotkeyDownCount} down / {hotkeyUpCount} up · pressed {pressedAtMs} · last release {lastQuickReleaseAtMs}</text>
    <text wrap="true">Captured source token: {sourceToken}</text>
    <row gap="8">
      <button on-press="show_overlay">Show overlay</button>
      <button on-press="hide_overlay">Hide overlay</button>
      <button on-press="probe_overlay">Probe overlay click</button>
    </row>
    <text>Last overlay action: {overlayAction}</text>
    <row gap="8">
      <button on-press="probe_textedit">Paste probe: TextEdit</button>
      <button on-press="probe_terminal">Paste probe: Terminal</button>
    </row>
    <row gap="8">
      <button variant="primary" on-press="start_audio_probe">Start microphone</button>
      <button on-press="stop_audio_probe">Stop and transcribe</button>
      <button on-press="probe_audio_storage">Probe 10-minute storage</button>
    </row>
    <text wrap="true">Audio: {audioDetail}</text>
    <row gap="8">
      <button on-press="probe_models">Probe repository guards</button>
      <button variant="primary" on-press="download_model">Download default model</button>
      <button on-press="cancel_download">Cancel download</button>
    </row>
    <row gap="8">
      <button on-press="transcribe_fixture">Transcribe fixture</button>
      <button on-press="cancel_fixture">Cancel fixture</button>
      <button on-press="unload_model">Unload NeMo</button>
    </row>
    <text wrap="true">Model: {modelDetail}</text>
    <text wrap="true">Model operation: {modelProgress}</text>
    <card>
      <column gap="6" padding="12">
        <text>Most recent probe</text>
        <text wrap="true">{probeResult}</text>
      </column>
    </card>
  </column>
</scroll>
