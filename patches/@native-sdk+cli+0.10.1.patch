new file mode 100644
index 0000000..f0eb59e
--- /dev/null
+++ b/node_modules/@native-sdk/cli/src/app_runner/no_extension.zig
@@ -0,0 +1,17 @@
+const std = @import("std");
+const native_sdk = @import("native_sdk");
+
+/// The stock runner always owns one extension lifecycle. Apps without an
+/// extension receive this no-op implementation, keeping optionality in the
+/// build graph rather than in the runner's resource ordering.
+pub const Host = struct {
+    pub fn create(_: std.mem.Allocator, _: std.Io, _: []const u8) !Host {
+        return .{};
+    }
+
+    pub fn destroy(_: *Host) void {}
+
+    pub fn binding(_: *Host) ?native_sdk.HostCallBinding {
+        return null;
+    }
+};
