{
  "name": "friday",
  "private": true,
  "description": "Friday local dictation app build toolchain.",
  "scripts": {
    "postinstall": "patch-package",
    "check": "native check",
    "test": "tsx --test tests/*.test.ts && zig build test -Dtarget=aarch64-macos",
    "build": "zig build -Dtarget=aarch64-macos",
    "package": "bash scripts/package-macos.sh",
    "clean:local": "bash scripts/clean-local-artifacts.sh"
  },
  "dependencies": {
    "@native-sdk/core": "0.10.1"
  },
  "devDependencies": {
    "@native-sdk/cli": "0.10.1",
    "patch-package": "8.0.0",
    "tsx": "^4.20.6"
  }
}
